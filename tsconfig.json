{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmitOnError": false,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "declaration": true,
    "skipLibCheck": true,
    "downlevelIteration": true
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

